{
  "link_libs": ["ghostty-internal"],
  "frameworks_macos": [
    "Foundation",
    "AppKit",
    "CoreFoundation",
    "CoreText",
    "CoreGraphics",
    "Metal",
    "MetalKit",
    "OpenGL",
    "QuartzCore",
    "IOSurface",
    "Carbon"
  ],
  "frameworks_ios": [
    "Foundation",
    "UIKit",
    "CoreFoundation",
    "CoreText",
    "CoreGraphics",
    "Metal",
    "MetalKit",
    "OpenGLES",
    "QuartzCore",
    "IOSurface"
  ],
  "system_libs_macos": ["c++", "objc"],
  "system_libs_ios": ["c++", "objc"],
  "system_libs_linux": ["stdc++"],
  "system_libs_windows": [
    "ws2_32",
    "advapi32",
    "kernel32",
    "user32",
    "shell32",
    "ole32",
    "oleaut32",
    "uuid",
    "gdi32",
    "winmm",
    "ntdll"
  ],
  "skip_static_linux": true,
  "skip_dynamic_linux": true,
  "skip_static_wasm": true,
  "skip_static_android": true,
  "no_run": false
}
